#!/usr/bin/env bash
# cftz - 聶.NET VPS Agent 管理工具
# Usage: cftz {install|uninstall|update|log|set|status}

set -euo pipefail

DOWNLOAD_BASE="${DOWNLOAD_BASE:-https://status.example.com}"
SERVICE_NAME="nstatus-metrics"
TASK_SERVICE_NAME="${SERVICE_NAME}-tasks"
INSTALL_DIR="/usr/local/bin"
WORK_DIR="/opt/nstatus-metrics"
STATE_DIR="/var/lib/nstatus-metrics"
ENV_FILE="${WORK_DIR}/nstatus-metrics.env"
BIN_NAME="nstatus-metrics"
AGENT_USER="nstatus"
LEGACY_TASK_USER="nstatus-task"

GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; RED='\033[0;31m'; BOLD='\033[1m'; NC='\033[0m'
NL=$'\n'
ok()    { echo -e "  ${GREEN}[OK]${NC} $*"; }
warn()  { echo -e "  ${YELLOW}!${NC} $*"; }
err()   { echo -e "  ${RED}[ERR]${NC} $*" >&2; }
info()  { echo -e "  $*"; }

curl_config_escape() {
    local s="${1-}"
    s=${s//\\/\\\\}
    s=${s//"/\\"}
    printf '%s' "$s"
}

curl_with_secret_header() {
    local header_name="$1" credential="$2" cfg rc
    shift 2
    cfg=$(mktemp) || return 1
    chmod 0600 "$cfg" 2>/dev/null || true
    {
        printf 'header = "%s: %s"\n' "$header_name" "$(curl_config_escape "$credential")"
    } > "$cfg"
    if curl --config "$cfg" "$@"; then
        rc=0
    else
        rc=$?
    fi
    rm -f "$cfg"
    return $rc
}

curl_agent_api() {
    local token="$1"
    shift
    curl_with_secret_header "Authorization" "Bearer ${token}" "$@"
}

curl_admin_api() {
    local session="$1"
    shift
    curl_with_secret_header "x-admin-session" "$session" "$@"
}

create_system_user() {
    local user="$1" shell_path uid gid
    if id -u "$user" >/dev/null 2>&1; then
        uid="$(id -u "$user")"
    else
        shell_path="$(command -v nologin 2>/dev/null || true)"
        [[ -x "$shell_path" ]] || shell_path="/bin/false"
        if command -v useradd >/dev/null 2>&1; then
            useradd --system --no-create-home --shell "$shell_path" "$user" 2>/dev/null \
                || useradd -r -M -s "$shell_path" "$user" 2>/dev/null \
                || true
        elif command -v adduser >/dev/null 2>&1; then
            adduser --system --no-create-home --shell "$shell_path" "$user" 2>/dev/null \
                || adduser -S -D -H -s "$shell_path" "$user" 2>/dev/null \
                || adduser -D -H -s "$shell_path" "$user" 2>/dev/null \
                || true
        fi
        uid="$(id -u "$user" 2>/dev/null || true)"
    fi
    gid="$(id -g "$user" 2>/dev/null || true)"
    if [[ ! "$uid" =~ ^[0-9]+$ || "$uid" == "0" || ! "$gid" =~ ^[0-9]+$ || "$gid" == "0" ]]; then
        err "无法创建非 root 系统用户: $user"
        return 1
    fi
}

json_escape() {
    local s="${1-}"
    s=${s//\\/\\\\}; s=${s//"/\\"}; s=${s//$'\n'/\\n}; s=${s//$'\r'/\\r}; s=${s//$'\t'/\\t}
    printf '%s' "$s"
}

admin_login() {
    local api="$1" username="$2" password="$3" totp="${4:-}" body response session
    body="{\"username\":\"$(json_escape "$username")\",\"password\":\"$(json_escape "$password")\""
    [[ -n "$totp" ]] && body="$body,\"totp\":\"$(json_escape "$totp")\""
    body="$body}"
    response=$(printf '%s' "$body" | curl -sS --max-time 10 "${api}/api/auth/login" \
        -H "Content-Type: application/json" --data-binary @-) || return 1
    session=$(printf '%s' "$response" | grep -o '"session_id":"[^"]*"' | head -1 | sed 's/"session_id":"//;s/"//') || true
    if [[ -z "$session" ]]; then
        err "登录失败: $(printf '%s' "$response" | head -c 200)"
        return 1
    fi
    printf '%s' "$session"
}

shell_quote() {
    local s="${1-}"
    s=${s//\'/\'\"\'\"\'}
    printf "'%s'" "$s"
}

write_env_file() {
    local api="$1" tok="$2" aid="$3" label="$4" interval="$5" ping_targets="${6:-}" ping_sec="${7:-}"
    mkdir -p "$WORK_DIR"
    {
        printf 'NSTATUS_API_BASE=%s\n' "$(shell_quote "$api")"
        printf 'NSTATUS_AGENT_TOKEN=%s\n' "$(shell_quote "$tok")"
        printf 'NSTATUS_AGENT_ID=%s\n' "$(shell_quote "$aid")"
        printf 'NSTATUS_AGENT_LABEL=%s\n' "$(shell_quote "$label")"
        printf 'NSTATUS_INTERVAL_SEC=%s\n' "$(shell_quote "$interval")"
        printf 'NSTATUS_SAMPLE_SEC=1\n'
        printf 'NSTATUS_QUEUE_FILE=%s\n' "$(shell_quote "${STATE_DIR}/samples-queue.json")"
        printf 'NSTATUS_PRIVILEGED_UPDATER=1\n'
        if [[ -n "${ping_targets}" ]]; then
            printf 'NSTATUS_PING_TARGETS=%s\n' "$(shell_quote "$ping_targets")"
        fi
        if [[ -n "${ping_sec}" ]]; then
            printf 'NSTATUS_PING_SEC=%s\n' "$(shell_quote "$ping_sec")"
        fi
    } > "$ENV_FILE"
    chmod 0600 "$ENV_FILE"
}

assert_safe_install_paths() {
    local path
    for path in "$WORK_DIR" "$STATE_DIR" "$ENV_FILE" "${WORK_DIR}/${BIN_NAME}"; do
        if [[ -L "$path" ]]; then
            err "refusing symbolic-link install path: $path"
            exit 1
        fi
    done
}

secure_install_permissions() {
    assert_safe_install_paths
    local agent_group
    agent_group="$(id -gn "$AGENT_USER" 2>/dev/null || printf '%s' "$AGENT_USER")"
    mkdir -p "$WORK_DIR" "$STATE_DIR"
    if [[ -f "${WORK_DIR}/samples-queue.json" && ! -e "${STATE_DIR}/samples-queue.json" ]]; then
        mv "${WORK_DIR}/samples-queue.json" "${STATE_DIR}/samples-queue.json"
    fi
    chown root:root "$WORK_DIR"
    chmod 0755 "$WORK_DIR"
    if [[ -f "$ENV_FILE" ]]; then
        if ! grep -q '^NSTATUS_QUEUE_FILE=' "$ENV_FILE"; then
            printf 'NSTATUS_QUEUE_FILE=%s\n' "$(shell_quote "${STATE_DIR}/samples-queue.json")" >> "$ENV_FILE"
        fi
        if ! grep -q '^NSTATUS_PRIVILEGED_UPDATER=' "$ENV_FILE"; then
            printf 'NSTATUS_PRIVILEGED_UPDATER=1\n' >> "$ENV_FILE"
        fi
        chown "root:${agent_group}" "$ENV_FILE"
        chmod 0640 "$ENV_FILE"
    fi
    if [[ -f "${WORK_DIR}/${BIN_NAME}" ]]; then
        chown root:root "${WORK_DIR}/${BIN_NAME}"
        chmod 0755 "${WORK_DIR}/${BIN_NAME}"
    fi
    chown -R "${AGENT_USER}:${agent_group}" "$STATE_DIR"
    chmod 0750 "$STATE_DIR"
    if [[ -f "${INSTALL_DIR}/cftz" ]]; then
        chown root:root "${INSTALL_DIR}/cftz"
        chmod 0755 "${INSTALL_DIR}/cftz"
    fi
}

download_to() {
    local url="$1" out="$2"
    if command -v curl &>/dev/null; then curl -fSL "$url" -o "$out" --progress-bar
    elif command -v wget &>/dev/null; then wget -q --show-progress "$url" -O "$out"
    else err "curl or wget is required"; return 1; fi
}

sha256_file() {
    local file="$1"
    if command -v sha256sum &>/dev/null; then sha256sum "$file" | awk '{print $1}'
    elif command -v shasum &>/dev/null; then shasum -a 256 "$file" | awk '{print $1}'
    elif command -v openssl &>/dev/null; then openssl dgst -sha256 "$file" | awk '{print $NF}'
    else err "sha256sum, shasum or openssl is required"; return 1; fi
}

json_string_value() {
    local key="$1"
    sed -n "s/.*\"${key}\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" | head -n 1
}

version_is_newer() {
    local candidate="${1#v}" current="${2#v}"
    local candidate_major candidate_minor candidate_patch current_major current_minor current_patch
    [[ "$candidate" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && "$current" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 2
    IFS=. read -r candidate_major candidate_minor candidate_patch <<< "$candidate"
    IFS=. read -r current_major current_minor current_patch <<< "$current"
    (( 10#$candidate_major > 10#$current_major )) && return 0
    (( 10#$candidate_major < 10#$current_major )) && return 1
    (( 10#$candidate_minor > 10#$current_minor )) && return 0
    (( 10#$candidate_minor < 10#$current_minor )) && return 1
    (( 10#$candidate_patch > 10#$current_patch ))
}


detect_arch() {
    case "$(uname -m)" in
        x86_64|amd64)  echo "amd64" ;;
        i386|i486|i586|i686) echo "386" ;;
        aarch64|arm64) echo "arm64" ;;
        armv6*)        echo "armv6" ;;
        armv7l|armv7*|armhf) echo "arm" ;;
        *)             err "unsupported architecture: $(uname -m)"; exit 1 ;;
    esac
}

download_binary() {
    local api="$1" tok="$2" aid="$3" automatic="${4:-0}" arch binary_name policy download_base manifest_hash latest_version auto_update current_version
    arch="$(detect_arch)"
    binary_name="${BIN_NAME}-linux-${arch}"
    policy="$(curl_agent_api "$tok" -fsSL --get --data-urlencode "agent_id=${aid}" "${api%/}/api/agent/update-policy")" || {
        err "unable to fetch trusted update policy"
        exit 1
    }
    download_base="$(printf '%s' "$policy" | json_string_value download_base)"
    manifest_hash="$(printf '%s' "$policy" | json_string_value manifest_sha256 | tr 'A-F' 'a-f')"
    latest_version="$(printf '%s' "$policy" | json_string_value latest_version)"
    auto_update="$(printf '%s' "$policy" | sed -n 's/.*"auto_update"[[:space:]]*:[[:space:]]*\(true\|false\).*/\1/p' | head -n 1)"
    if [[ "$automatic" == "1" && "$auto_update" != "true" ]]; then
        echo "__AUTO_UPDATE_DISABLED__"
        return 0
    fi
    [[ -n "$latest_version" ]] || { err "update policy has no version"; exit 1; }
    current_version="$("${WORK_DIR}/${BIN_NAME}" --version 2>/dev/null || true)"
    if [[ "$automatic" == "1" ]]; then
        if version_is_newer "$latest_version" "$current_version"; then
            :
        else
            local version_status=$?
            if [[ "$version_status" == "1" ]]; then
                echo "__ALREADY_CURRENT__"
                return 0
            fi
            err "invalid Agent version comparison: ${latest_version} / ${current_version}"
            exit 1
        fi
    fi
    [[ "$download_base" == https://* ]] || { err "update download base must use HTTPS"; exit 1; }
    [[ "$manifest_hash" =~ ^[0-9a-f]{64}$ ]] || { err "update policy has no valid manifest hash"; exit 1; }

    local tmpbin sums expected actual sums_actual reported
    tmpbin="$(mktemp)"
    sums="$(mktemp)"
    download_to "${download_base%/}/bin/SHA256SUMS" "$sums" || { rm -f "$tmpbin" "$sums"; exit 1; }
    sums_actual="$(sha256_file "$sums")"
    if [[ "${sums_actual,,}" != "$manifest_hash" ]]; then
        rm -f "$tmpbin" "$sums"
        err "update manifest checksum mismatch"
        exit 1
    fi
    expected="$(awk -v name="$binary_name" '$2 == name || $2 == "bin/" name { print $1; exit }' "$sums")"
    [[ "$expected" =~ ^[0-9A-Fa-f]{64}$ ]] || { rm -f "$tmpbin" "$sums"; err "manifest is missing ${binary_name}"; exit 1; }
    download_to "${download_base%/}/bin/${binary_name}" "$tmpbin" || { rm -f "$tmpbin" "$sums"; exit 1; }
    actual="$(sha256_file "$tmpbin")"
    rm -f "$sums"
    if [[ "${actual,,}" != "${expected,,}" ]]; then
        rm -f "$tmpbin"
        err "Agent binary checksum mismatch"
        exit 1
    fi
    chmod +x "$tmpbin"
    reported="$("$tmpbin" --version 2>&1)" || { rm -f "$tmpbin"; err "downloaded Agent cannot run"; exit 1; }
    [[ "$reported" == "$latest_version" ]] || { rm -f "$tmpbin"; err "Agent version mismatch: ${reported} != ${latest_version}"; exit 1; }
    echo "$tmpbin"
}

read_env() {
    if [[ ${EUID:-$(id -u)} -eq 0 && -d "$WORK_DIR" ]] && id -u "$AGENT_USER" &>/dev/null; then
        secure_install_permissions
    fi
    if [[ -f "$ENV_FILE" ]]; then
        if source "$ENV_FILE" 2>/dev/null; then
            return 0
        fi
        while IFS= read -r line || [[ -n "$line" ]]; do
            line=${line%$'\r'}
            [[ -z "$line" || "$line" == \#* ]] && continue
            [[ "$line" == export\ * ]] && line=${line#export }
            [[ "$line" == *"="* ]] || continue
            local key="${line%%=*}"
            local val="${line#*=}"
            key="${key#"${key%%[![:space:]]*}"}"
            key="${key%"${key##*[![:space:]]}"}"
            [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
            printf -v "$key" '%s' "$val"
            export "$key"
        done < "$ENV_FILE"
    fi
}

install_openrc_update_job() {
    local job_dir=""
    if [[ -d /etc/periodic/hourly ]]; then
        job_dir="/etc/periodic/hourly"
    elif [[ -d /etc/cron.hourly ]]; then
        job_dir="/etc/cron.hourly"
    else
        warn "未找到 OpenRC 每小时任务目录；请使用 cftz update 手动更新"
        return 0
    fi
    cat > "${job_dir}/${SERVICE_NAME}-update" <<EOF
#!/bin/sh
if rc-service ${TASK_SERVICE_NAME} status >/dev/null 2>&1; then
    exit 0
fi
exec ${INSTALL_DIR}/cftz update --automatic >>/var/log/${SERVICE_NAME}-update.log 2>&1
EOF
    chmod 0755 "${job_dir}/${SERVICE_NAME}-update"
    if [[ -x /etc/init.d/crond ]]; then
        rc-update add crond default >/dev/null 2>&1 || true
        rc-service crond start >/dev/null 2>&1 || true
    elif [[ -x /etc/init.d/cron ]]; then
        rc-update add cron default >/dev/null 2>&1 || true
        rc-service cron start >/dev/null 2>&1 || true
    fi
}

write_service_unit() {
    local init
    init=$(detect_init)
    case "$init" in
        systemd)
            cat > "/etc/systemd/system/${SERVICE_NAME}.service" <<EOF
[Unit]
Description=聶.NET VPS Metrics Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=${STATE_DIR}
EnvironmentFile=${ENV_FILE}
ExecStart=${WORK_DIR}/${BIN_NAME}
Restart=always
RestartSec=15
User=${AGENT_USER}
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=${STATE_DIR}
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
EOF
            cat > "/etc/systemd/system/${TASK_SERVICE_NAME}.service" <<EOF
[Unit]
Description=NIE-SLA privileged Agent manager
After=network-online.target ${SERVICE_NAME}.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=${STATE_DIR}
EnvironmentFile=${ENV_FILE}
Environment=NSTATUS_TASK_RUNNER_ONLY=1
ExecStart=${WORK_DIR}/${BIN_NAME} --task-runner-only
Restart=always
RestartSec=20
User=root
PrivateTmp=true
ProtectHome=true
UMask=0027
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
EOF
            cat > "/etc/systemd/system/${SERVICE_NAME}-update.service" <<EOF
[Unit]
Description=聶.NET Agent privileged recovery update
After=network-online.target

[Service]
Type=oneshot
ExecCondition=/bin/sh -c '! systemctl is-active --quiet ${TASK_SERVICE_NAME}'
ExecStart=${INSTALL_DIR}/cftz update --automatic
EOF
            cat > "/etc/systemd/system/${SERVICE_NAME}-update.timer" <<EOF
[Unit]
Description=Recover 聶.NET Agent manager and verified updates

[Timer]
OnBootSec=5min
OnUnitActiveSec=1h
RandomizedDelaySec=5min
Persistent=true

[Install]
WantedBy=timers.target
EOF
            ;;
        openrc)
            cat > "/etc/init.d/${SERVICE_NAME}" <<EOF
#!/sbin/openrc-run
name="${SERVICE_NAME}"
description="聶.NET VPS Metrics Agent"

start() {
    ebegin "Starting ${SERVICE_NAME}"
    touch "/var/log/${SERVICE_NAME}.log"
    chown "${AGENT_USER}" "/var/log/${SERVICE_NAME}.log" 2>/dev/null || true
    start-stop-daemon --start --background --make-pidfile \
        --pidfile /run/${SERVICE_NAME}.pid \
        --user ${AGENT_USER} \
        --exec /bin/sh -- \
        -c 'cd "${STATE_DIR}"; set -a; . "${ENV_FILE}"; set +a; exec "${WORK_DIR}/${BIN_NAME}" >>"/var/log/${SERVICE_NAME}.log" 2>&1'
    eend \$?
}

stop() {
    ebegin "Stopping ${SERVICE_NAME}"
    start-stop-daemon --stop --pidfile /run/${SERVICE_NAME}.pid
    eend \$?
}

depend() { need net; }
EOF
            chmod +x "/etc/init.d/${SERVICE_NAME}"
            cat > "/etc/init.d/${TASK_SERVICE_NAME}" <<EOF
#!/sbin/openrc-run
name="${TASK_SERVICE_NAME}"
description="NIE-SLA privileged Agent manager"

start() {
    ebegin "Starting ${TASK_SERVICE_NAME}"
    start-stop-daemon --start --background --make-pidfile \
        --pidfile /run/${TASK_SERVICE_NAME}.pid \
        --exec /bin/sh -- \
        -c 'cd "${STATE_DIR}"; set -a; . "${ENV_FILE}"; set +a; export NSTATUS_TASK_RUNNER_ONLY=1; exec "${WORK_DIR}/${BIN_NAME}" --task-runner-only >>"/var/log/${TASK_SERVICE_NAME}.log" 2>&1'
    eend \$?
}

stop() {
    ebegin "Stopping ${TASK_SERVICE_NAME}"
    start-stop-daemon --stop --pidfile /run/${TASK_SERVICE_NAME}.pid
    eend \$?
}

depend() { need net; after ${SERVICE_NAME}; }
EOF
            chmod +x "/etc/init.d/${TASK_SERVICE_NAME}"
            install_openrc_update_job
            ;;
    esac
}

start_service() {
    case "$(detect_init)" in
        systemd)
            systemctl daemon-reload
            systemctl enable "$SERVICE_NAME" >/dev/null 2>&1 || true
            systemctl enable "$TASK_SERVICE_NAME" >/dev/null 2>&1 || true
            systemctl enable --now "${SERVICE_NAME}-update.timer" >/dev/null 2>&1 || true
            systemctl restart "$SERVICE_NAME"
            systemctl restart "$TASK_SERVICE_NAME"
            ;;
        openrc)
            rc-update add "$SERVICE_NAME" default 2>/dev/null || true
            rc-update add "$TASK_SERVICE_NAME" default 2>/dev/null || true
            rc-service "$SERVICE_NAME" start 2>/dev/null || true
            rc-service "$TASK_SERVICE_NAME" start 2>/dev/null || true
            ;;
        *)       "${WORK_DIR}/${BIN_NAME}" & ;;
    esac
}

reconcile_service_layout() {
    write_service_unit
    case "$(detect_init)" in
        systemd)
            systemctl daemon-reload
            systemctl enable "$SERVICE_NAME" >/dev/null 2>&1 || true
            systemctl enable "$TASK_SERVICE_NAME" >/dev/null 2>&1 || true
            systemctl enable --now "${SERVICE_NAME}-update.timer" >/dev/null 2>&1 || true
            if ! systemctl is-active --quiet "$TASK_SERVICE_NAME"; then
                systemctl start "$TASK_SERVICE_NAME"
            fi
            ;;
        openrc)
            rc-update add "$SERVICE_NAME" default >/dev/null 2>&1 || true
            rc-update add "$TASK_SERVICE_NAME" default >/dev/null 2>&1 || true
            if ! rc-service "$TASK_SERVICE_NAME" status >/dev/null 2>&1; then
                rc-service "$TASK_SERVICE_NAME" start
            fi
            ;;
    esac
}

# ── 子命令 ────────────────────────────────────────────────────────

detect_init() {
    if command -v systemctl &>/dev/null && [[ -d /run/systemd/system ]]; then echo "systemd"
    elif command -v rc-service &>/dev/null; then echo "openrc"
    else echo ""; fi
}

do_install() {
    [[ $EUID -ne 0 ]] && { err "请使用 root 权限: sudo cftz install"; exit 1; }

    echo -e "\n${BOLD}正在安装 聶.NET Metrics Agent${NC}\n"

    local arch=$(detect_arch)
    info "架构: ${arch}"

    local api="${NSTATUS_API_BASE:-}"
    local tok="${NSTATUS_AGENT_TOKEN:-}"
    local aid="${NSTATUS_AGENT_ID:-$(hostname)}"
    local interval="${NSTATUS_INTERVAL_SEC:-300}"
    local ping_targets="${NSTATUS_PING_TARGETS:-*}"
    local ping_sec="${NSTATUS_PING_SEC:-20}"

    [[ -z "$api" ]] && read -rp "  API URL: " api </dev/tty
    [[ -z "$tok" ]] && { read -rsp "  Token: " tok </dev/tty; echo; }
    [[ -z "$api" || -z "$tok" ]] && { err "API 和 Token 不能为空"; exit 1; }

    local tmpbin
    tmpbin="$(download_binary "$api" "$tok" "$aid")"

    # 普通遥测保持低权限；NQ/IP 固定诊断由 root Manager 直接执行。
    create_system_user "$AGENT_USER"
    ok "用户已就绪: ${AGENT_USER}"

    assert_safe_install_paths
    mkdir -p "$WORK_DIR" "$STATE_DIR"
    if command -v install &>/dev/null; then
        install -m 0755 "$tmpbin" "${WORK_DIR}/${BIN_NAME}"
    else
        cp "$tmpbin" "${WORK_DIR}/${BIN_NAME}"; chmod 0755 "${WORK_DIR}/${BIN_NAME}"
    fi
    ln -sf "${WORK_DIR}/${BIN_NAME}" "${INSTALL_DIR}/${BIN_NAME}"
    rm -f "$tmpbin"

    write_env_file "$api" "$tok" "$aid" "$aid" "$interval" "$ping_targets" "$ping_sec"
    secure_install_permissions

    write_service_unit
    start_service
    ok "服务已启动"

    echo
    info "目标: ${aid}"
    info "日志: cftz log"
}

do_uninstall() {
    [[ $EUID -ne 0 ]] && { err "请使用 root 权限: sudo cftz uninstall"; exit 1; }

    echo -e "\n${BOLD}正在卸载 聶.NET Metrics Agent${NC}\n"

    local init=$(detect_init)
    case "$init" in
        systemd)
            systemctl stop "$SERVICE_NAME" "$TASK_SERVICE_NAME" 2>/dev/null || true
            systemctl disable "$SERVICE_NAME" 2>/dev/null || true
            systemctl disable "$TASK_SERVICE_NAME" 2>/dev/null || true
            systemctl disable --now "${SERVICE_NAME}-update.timer" 2>/dev/null || true
            rm -f "/etc/systemd/system/${SERVICE_NAME}.service"
            rm -f "/etc/systemd/system/${TASK_SERVICE_NAME}.service"
            rm -f "/etc/systemd/system/${SERVICE_NAME}-update.service" "/etc/systemd/system/${SERVICE_NAME}-update.timer"
            systemctl daemon-reload 2>/dev/null || true
            ;;
        openrc)
            rc-service "$SERVICE_NAME" stop 2>/dev/null || true
            rc-service "$TASK_SERVICE_NAME" stop 2>/dev/null || true
            rc-update del "$SERVICE_NAME" 2>/dev/null || true
            rc-update del "$TASK_SERVICE_NAME" 2>/dev/null || true
            rm -f "/etc/init.d/${SERVICE_NAME}" "/etc/init.d/${TASK_SERVICE_NAME}"
            rm -f "/etc/periodic/hourly/${SERVICE_NAME}-update" "/etc/cron.hourly/${SERVICE_NAME}-update"
            ;;
    esac
    rm -f "${INSTALL_DIR}/${BIN_NAME}"
    rm -f "${INSTALL_DIR}/cftz"
    rm -rf "$WORK_DIR" "$STATE_DIR"
    rm -rf "/var/lib/nstatus-manager"
    userdel "$AGENT_USER" 2>/dev/null || deluser "$AGENT_USER" 2>/dev/null || true
    userdel "$LEGACY_TASK_USER" 2>/dev/null || deluser "$LEGACY_TASK_USER" 2>/dev/null || true

    ok "已完全移除"
}

do_update() {
    [[ $EUID -ne 0 ]] && { err "请使用 root 权限: sudo cftz update"; exit 1; }

    echo -e "\n${BOLD}正在更新 聶.NET Metrics Agent${NC}\n"

    if [[ ! -f "${WORK_DIR}/${BIN_NAME}" && ! -f "${INSTALL_DIR}/${BIN_NAME}" ]]; then
        err "Agent 未安装，请先运行: cftz install"
        exit 1
    fi

    local automatic=0
    [[ "${1:-}" == "--automatic" ]] && automatic=1
    secure_install_permissions
    read_env
    local api="${NSTATUS_API_BASE:-}" tok="${NSTATUS_AGENT_TOKEN:-}" aid="${NSTATUS_AGENT_ID:-}" tmpbin backup
    [[ -n "$api" && -n "$tok" && -n "$aid" ]] || { err "Agent 配置不完整，无法获取可信更新策略"; exit 1; }
    tmpbin="$(download_binary "$api" "$tok" "$aid" "$automatic")"
    if [[ "$tmpbin" == "__AUTO_UPDATE_DISABLED__" ]]; then
        reconcile_service_layout
        info "自动更新已关闭，本次不安装更新"
        return 0
    fi
    if [[ "$tmpbin" == "__ALREADY_CURRENT__" ]]; then
        reconcile_service_layout
        info "Agent 已是最新版本"
        return 0
    fi
    backup="${WORK_DIR}/${BIN_NAME}.bak"
    cp -p "${WORK_DIR}/${BIN_NAME}" "$backup"
    local init=$(detect_init)
    case "$init" in
        systemd) systemctl stop "$SERVICE_NAME" "$TASK_SERVICE_NAME" 2>/dev/null || true ;;
        openrc)  rc-service "$SERVICE_NAME" stop 2>/dev/null || true; rc-service "$TASK_SERVICE_NAME" stop 2>/dev/null || true ;;
    esac
    mkdir -p "$WORK_DIR"
    if command -v install &>/dev/null; then
        install -m 0755 "$tmpbin" "${WORK_DIR}/${BIN_NAME}"
    else
        cp "$tmpbin" "${WORK_DIR}/${BIN_NAME}"; chmod 0755 "${WORK_DIR}/${BIN_NAME}"
    fi
    ln -sf "${WORK_DIR}/${BIN_NAME}" "${INSTALL_DIR}/${BIN_NAME}"
    rm -f "$tmpbin"
    secure_install_permissions
    write_service_unit
    if ! start_service; then
        mv -f "$backup" "${WORK_DIR}/${BIN_NAME}"
        secure_install_permissions
        start_service || true
        err "新版本启动失败，已回滚"
        exit 1
    fi
    rm -f "$backup"

    ok "更新完成并已重启"
}

do_log() {
    local lines="${1:-30}"
    case "$(detect_init)" in
        systemd)
            journalctl -u "$SERVICE_NAME" -n "$lines" --no-pager
            ;;
        openrc)
            if [[ -f "/var/log/${SERVICE_NAME}.log" ]]; then
                tail -n "$lines" "/var/log/${SERVICE_NAME}.log"
            elif [[ -f /var/log/messages ]]; then
                grep "$SERVICE_NAME" /var/log/messages | tail -n "$lines" || true
            else
                warn "未找到 OpenRC 日志文件"
            fi
            ;;
        *)
            warn "未检测到 systemd/OpenRC，无法读取服务日志"
            ;;
    esac
}

restart_service() {
    case "$(detect_init)" in
        systemd) systemctl restart "$SERVICE_NAME" "$TASK_SERVICE_NAME" ;;
        openrc)  rc-service "$SERVICE_NAME" restart; rc-service "$TASK_SERVICE_NAME" restart ;;
        *)       pkill -f "${WORK_DIR}/${BIN_NAME}" 2>/dev/null || true; "${WORK_DIR}/${BIN_NAME}" & ;;
    esac
}

do_set() {
    [[ $EUID -ne 0 ]] && { err "请使用 root 权限: sudo cftz set"; exit 1; }

    if [[ ! -f "$ENV_FILE" ]]; then
        err "Agent 未安装，请先运行: cftz install"
        exit 1
    fi

    secure_install_permissions
    read_env
    local api="${NSTATUS_API_BASE:-}"
    local tok="${NSTATUS_AGENT_TOKEN:-}"
    local aid="${NSTATUS_AGENT_ID:-}"
    local interval="${NSTATUS_INTERVAL_SEC:-300}"
    local ping_targets="${NSTATUS_PING_TARGETS:-*}"
    local ping_sec="${NSTATUS_PING_SEC:-20}"

    while true; do
        echo -e "\n${BOLD}Agent 配置${NC}\n"
        info "目标 ID = 管理面板中探针目标的 ID"
        echo
        printf "  ${CYAN}1${NC}) API 地址:     ${api:-<未设置>}\n"
        printf "  ${CYAN}2${NC}) Token:        ${tok:0:8}****\n"
        printf "  ${CYAN}3${NC}) 目标 ID:      ${aid:-<未设置>}\n"
        printf "  ${CYAN}4${NC}) 上报间隔:     ${interval}s\n"
        printf "  ${CYAN}5${NC}) Ping 目标:    ${ping_targets:-无}\n"
        printf "  ${CYAN}6${NC}) Ping 间隔:    ${ping_sec}s\n"
        echo
        info "选择编号修改 (回车保存退出):"
        read -rp "  [1-6]: " sel </dev/tty

        case "${sel:-}" in
            1) IFS= read -rp "  API 地址 [${api}]: " v </dev/tty; [[ -n "$v" ]] && api="$v"; ok "API: ${api}" ;;
            2) read -rsp "  Token [${tok:0:8}****]: " v </dev/tty; echo; [[ -n "$v" ]] && tok="$v"; ok "Token 已更新" ;;
            3) aid=$(do_set_target "$api" "$tok" "$aid") ;;
            4) read -rp "  上报间隔秒 [${interval}]: " v </dev/tty; [[ -n "$v" ]] && interval="$v"; ok "间隔: ${interval}s" ;;
            5) read -rp "  Ping 目标（逗号分隔 ID，* 为全部） [${ping_targets}]: " v </dev/tty; [[ -n "$v" ]] && ping_targets="$v"; ok "Ping 目标: ${ping_targets}" ;;
            6) read -rp "  Ping 间隔秒 [${ping_sec}]: " v </dev/tty; [[ -n "$v" ]] && ping_sec="$v"; ok "Ping 间隔: ${ping_sec}s" ;;
            "") break ;;
            *) warn "无效选择" ;;
        esac
    done

    write_env_file "$api" "$tok" "$aid" "$aid" "$interval" "$ping_targets" "$ping_sec"
    secure_install_permissions
    write_service_unit
    restart_service

    ok "配置已保存并重启"
    info "目标: ${aid}"
    info "Ping:  ${ping_targets:-无}"
}

do_set_target() {
    local api="$1" tok="$2" cur="$3"
    local list_json
    list_json=$(curl_agent_api "$tok" -sL --max-time 10 "${api}/api/agent/targets" \
        -H "Accept: application/json" 2>/dev/null) || true

    if [[ -z "$list_json" ]]; then
        warn "API 不可达或返回为空，请手动输入" >&2
        read -rp "  目标 ID [${cur}]: " v </dev/tty
        echo "${v:-$cur}"
        return
    fi

    if ! echo "$list_json" | grep -q '"ok": true'; then
        warn "API 错误: $(echo "$list_json" | head -c 120)" >&2
        read -rp "  目标 ID [${cur}]: " v </dev/tty
        echo "${v:-$cur}"
        return
    fi

    # 显示输出到 stderr (调用者用 $(...) 捕获 stdout)
    echo -e "\n${BOLD}可选探针目标${NC} (选择作为本 Agent 的目标 ID)\n" >&2
    local ol=$(echo "$list_json" | tr -d '\r\n\t ')
    local pr="${ol//'{"id"'/${NL}{\"id\"}}"
    local pc=0
    declare -a aids=() anames=() atypes=()
    while IFS= read -r obj; do
        [[ -z "$obj" ]] && continue
        echo "$obj" | grep -q '^{"id"' || continue
        local pid=$(echo "$obj" | grep -o '"id":"[^"]*"' | head -1 | sed 's/"id":"//;s/"//') || true
        local pn=$(echo "$obj" | grep -o '"name":"[^"]*"' | head -1 | sed 's/"name":"//;s/"//') || true
        local pt=$(echo "$obj" | grep -o '"type":"[^"]*"' | head -1 | sed 's/"type":"//;s/"//') || true
        [[ -z "$pid" ]] && continue
        pc=$((pc + 1))
        aids+=("$pid"); anames+=("$pn"); atypes+=("$pt")
        local mark=" "
        [[ "$pid" == "$cur" ]] && mark="*"
        printf "  ${CYAN}%s%2d${NC}) %-30s %s %s\n" "$mark" "$pc" "$pn" "$pt" "$pid" >&2
    done <<< "$pr"

    if [[ $pc -eq 0 ]]; then
        warn "未找到目标，请手动输入" >&2
        read -rp "  目标 ID [${cur}]: " v </dev/tty
        echo "${v:-$cur}"
        return
    fi

    echo >&2
    info "当前: ${cur}  (* = 已选中)  回车=保持当前" >&2
    read -rp "  输入编号或手动输入 ID: " choice </dev/tty

    if [[ -z "$choice" ]]; then
        ok "目标: ${cur}" >&2
        echo "$cur"
    elif [[ "$choice" =~ ^[0-9]+$ && "$choice" -ge 1 && "$choice" -le $pc ]]; then
        local idx=$((choice - 1))
        ok "目标: ${anames[$idx]} (${aids[$idx]})" >&2
        echo "${aids[$idx]}"
    else
        ok "目标: ${choice}" >&2
        echo "$choice"
    fi
}

do_set_ping() {
    local api="$1" tok="$2" cur="$3"
    local pt_list=""
    pt_list=$(curl_agent_api "$tok" -sL --max-time 10 "${api}/api/agent/ping-targets" \
        -H "Accept: application/json" 2>/dev/null) || true

    if [[ -z "$pt_list" ]] || echo "$pt_list" | grep -q '"Unauthorized"'; then
        warn "无法获取 Ping 目标列表" >&2
        read -rp "  Ping 目标 (ID逗号分隔, *=全部, 空=禁用): " v </dev/tty
        echo "${v:-$cur}"
        return
    fi

    local ol=$(echo "$pt_list" | tr -d '\r\n\t ')
    local pr="${ol//'{"id"'/${NL}{\"id\"}}"
    local pc=0
    declare -a pids=() pnames=() ptgts=()

    while IFS= read -r obj; do
        [[ -z "$obj" ]] && continue
        echo "$obj" | grep -q '^{"id"' || continue
        local pid=$(echo "$obj" | grep -o '"id":"[^"]*"' | head -1 | sed 's/"id":"//;s/"//') || true
        local pn=$(echo "$obj" | grep -o '"name":"[^"]*"' | head -1 | sed 's/"name":"//;s/"//') || true
        local pt=$(echo "$obj" | grep -o '"target":"[^"]*"' | head -1 | sed 's/"target":"//;s/"//') || true
        [[ -z "$pid" ]] && continue
        pc=$((pc + 1))
        pids+=("$pid")
        pnames+=("$pn")
        ptgts+=("$pt")
        printf "  ${CYAN}%2d${NC})  %-20s -> %s\n" "$pc" "$pn" "$pt" >&2
    done <<< "$pr"

    [[ $pc -eq 0 ]] && { warn "没有可用的 Ping 目标" >&2; echo "$cur"; return; }

    echo >&2
    info "当前: ${cur:-无}  |  *=全部  none=禁用" >&2
    read -rp "  输入编号 (逗号分隔多选): " choice </dev/tty

    if [[ "$choice" == "none" ]]; then
        ok "TCP Ping 已禁用" >&2
        echo ""
    elif [[ -z "$choice" ]] || [[ "$choice" == "*" ]]; then
        ok "已选择全部 ${pc} 个目标" >&2
        echo "*"
    else
        local result=""
        IFS=',' read -ra chs <<< "$choice"
        for ch in "${chs[@]}"; do
            ch=$(echo "$ch" | tr -d ' ')
            [[ "$ch" =~ ^[0-9]+$ && "$ch" -ge 1 && "$ch" -le $pc ]] || continue
            local idx=$((ch - 1))
            result="${result}${result:+,}${pids[$idx]}"
        done
        if [[ -n "$result" ]]; then
            ok "已选择: $result" >&2
            echo "$result"
        else
            warn "无效选择，保持当前值" >&2
            echo "$cur"
        fi
    fi
}

do_status() {
    case "$(detect_init)" in
        systemd) systemctl status "$SERVICE_NAME" --no-pager 2>/dev/null || warn "服务未运行" ;;
        openrc)  rc-service "$SERVICE_NAME" status 2>/dev/null || warn "服务未运行" ;;
        *)       pgrep -af "${WORK_DIR}/${BIN_NAME}" 2>/dev/null || pgrep -af "${INSTALL_DIR}/${BIN_NAME}" 2>/dev/null || warn "服务未运行" ;;
    esac
}

# ── 管理面板 ──────────────────────────────────────────────────────

do_admin() {
    read_env
    local api="${NSTATUS_API_BASE:-}"
    local username="admin" password="" session=""
    local totp=""
    read -rp "  管理员账号 [admin]: " username </dev/tty
    username="${username:-admin}"
    read -rsp "  管理员密码: " password </dev/tty
    echo
    [[ -z "$password" ]] && { err "密码不能为空"; return 1; }

    read -rp "  TOTP 验证码 (未配置则留空): " totp </dev/tty
    if [[ -n "$totp" ]] && ! [[ "$totp" =~ ^[0-9]{6}$ ]]; then
        err "TOTP 验证码必须为6位数字"
        return 1
    fi

    session=$(admin_login "$api" "$username" "$password" "$totp") || return 1
    password=""
    local check
    check=$(curl_admin_api "$session" "" -sS --max-time 10 "${api}/api/targets" -H "Accept: application/json" 2>&1) || true
    if [[ -z "$check" ]]; then
        err "API 不可达: ${api}"
        return 1
    fi
    if ! echo "$check" | grep -q '"ok": true'; then
        err "管理会话无效: $(echo "$check" | head -c 200)"
        return 1
    fi
    ok "验证通过"

    while true; do
        echo -e "\n${BOLD}管理面板${NC}\n"
        echo -e "  ${CYAN}1${NC}) 管理探针目标 (VPS / Web)"
        echo -e "  ${CYAN}2${NC}) 管理 Ping 目标 (TCP Ping)"
        echo -e "  ${CYAN}q${NC}) 退出"
        echo
        read -rp "  选择: " sel </dev/tty
        case "${sel:-q}" in
            1) do_admin_targets "$api" "$session" "" ;;
            2) do_admin_pings "$api" "$session" "" ;;
            q|Q) break ;;
            *) warn "无效选择" ;;
        esac
    done
}

do_admin_targets() {
    local api="$1" tok="$2" totp="$3"
    while true; do
        local list_json
        if [[ -n "$totp" ]]; then
            list_json=$(curl_admin_api "$tok" "${totp:-}" -sL --max-time 10 "${api}/api/targets" \
                    -H "Accept: application/json" \
                    2>/dev/null) || true
        else
            list_json=$(curl_admin_api "$tok" "${totp:-}" -sL --max-time 10 "${api}/api/targets" \
                    -H "Accept: application/json" 2>/dev/null) || true
        fi

        local ol=$(echo "$list_json" | tr -d '\r\n\t ')
        local pr="${ol//'{"id"'/${NL}{\"id\"}}"
        local tc=0
        declare -a tids=() tnames=() ttypes=() tgroups=() tenabled=() thosts=() tports=() turls=()

        echo -e "\n${BOLD}探针目标${NC}\n"
        printf "  %-4s %-28s %-8s %-14s %s\n" "#" "名称" "类型" "分组" "状态"
        printf "  %-4s %-28s %-8s %-14s %s\n" "---" "----------------------------" "--------" "--------------" "------"
        while IFS= read -r obj; do
            [[ -z "$obj" ]] && continue
            echo "$obj" | grep -q '^{"id"' || continue
            local tid=$(echo "$obj" | grep -o '"id":"[^"]*"' | head -1 | sed 's/"id":"//;s/"//') || true
            local tn=$(echo "$obj" | grep -o '"name":"[^"]*"' | head -1 | sed 's/"name":"//;s/"//') || true
            local tt=$(echo "$obj" | grep -o '"type":"[^"]*"' | head -1 | sed 's/"type":"//;s/"//') || true
            local tg=$(echo "$obj" | grep -o '"group_name":"[^"]*"' | head -1 | sed 's/"group_name":"//;s/"//') || true
            local te=$(echo "$obj" | grep -o '"enabled":[0-9]*' | head -1 | sed 's/"enabled"://') || true
            local th=$(echo "$obj" | grep -o '"target_host":"[^"]*"' | head -1 | sed 's/"target_host":"//;s/"//') || true
            local tp=$(echo "$obj" | grep -o '"target_port":[0-9]*' | head -1 | sed 's/"target_port"://') || true
            local tu=$(echo "$obj" | grep -o '"url":"[^"]*"' | head -1 | sed 's/"url":"//;s/"//') || true
            [[ -z "$tid" ]] && continue
            tc=$((tc + 1))
            tids+=("$tid"); tnames+=("$tn"); ttypes+=("$tt"); tgroups+=("$tg"); tenabled+=("$te")
            thosts+=("$th"); tports+=("$tp"); turls+=("$tu")
            printf "  ${CYAN}%-4s${NC} %-28s %-8s %-14s %s\n" "${tc})" "$tn" "$tt" "$tg" "$([[ "$te" == "1" ]] && echo -e "${GREEN}启用${NC}" || echo -e "${RED}禁用${NC}")"
        done <<< "$pr"

        echo
        echo -e "  ${BOLD}a${NC}) 新增   ${BOLD}e${NC}) 编辑   ${BOLD}d${NC}) 删除   ${BOLD}t${NC}) 切换   ${BOLD}q${NC}) 返回"
        echo
        read -rp "  选择: " sel </dev/tty

        case "${sel:-q}" in
            q|Q) break ;;
            a|A)
                IFS= read -rp "  名称: " n </dev/tty
                read -rp "  类型 (tcp/http): " ty </dev/tty
                IFS= read -rp "  分组: " gr </dev/tty
                if [[ "$ty" == "http" ]]; then
                    IFS= read -rp "  URL: " ur </dev/tty
                    read -rp "  预期状态码 [200,301,302]: " es </dev/tty
                    local body="{\"name\":\"$n\",\"group_name\":\"$gr\",\"type\":\"http\",\"url\":\"$ur\",\"expected_status\":\"${es:-200,301,302}\"}"
                else
                    read -rp "  主机 [0.0.0.0]: " ho </dev/tty
                    read -rp "  端口 [1]: " po </dev/tty
                    read -rp "  区域 [auto]: " re </dev/tty
                    local body="{\"name\":\"$n\",\"group_name\":\"$gr\",\"type\":\"tcp\",\"target_host\":\"${ho:-0.0.0.0}\",\"target_port\":${po:-1},\"probe_region\":\"${re:-auto}\"}"
                fi
                local result=$(curl_admin_api "$tok" "${totp:-}" -sL --max-time 10 "${api}/api/targets" -X POST \
                    -H "Content-Type: application/json" \
                    -d "$body" 2>/dev/null)
                echo "$result" | grep -q '"ok": true' && ok "添加成功" || err "失败: $result"
                ;;
            e|E)
                read -rp "  编辑编号: " num </dev/tty
                [[ "$num" =~ ^[0-9]+$ && "$num" -ge 1 && "$num" -le $tc ]] || { warn "无效"; continue; }
                local idx=$((num - 1)); local tid="${tids[$idx]}"; local tt="${ttypes[$idx]}"
                read -rp "  ID [${tid}]: " nid </dev/tty
                nid="${nid:-$tid}"
                IFS= read -rp "  名称 [${tnames[$idx]}]: " n </dev/tty
                IFS= read -rp "  分组 [${tgroups[$idx]}]: " gr </dev/tty
                local name="${n:-${tnames[$idx]}}" group="${gr:-${tgroups[$idx]}}"
                if [[ "$nid" != "$tid" ]]; then
                    local body="{\"id\":\"$nid\",\"name\":\"$name\",\"group_name\":\"$group\""
                    if [[ "$tt" == "http" ]]; then
                        IFS= read -rp "  URL [${turls[$idx]}]: " ur </dev/tty
                        ur="${ur:-${turls[$idx]}}"
                        body="$body,\"url\":\"$ur\""
                    else
                        read -rp "  主机 [${thosts[$idx]}]: " ho </dev/tty
                        ho="${ho:-${thosts[$idx]}}"
                        read -rp "  端口 [${tports[$idx]}]: " po </dev/tty
                        po="${po:-${tports[$idx]}}"
                        body="$body,\"target_host\":\"$ho\",\"target_port\":$po"
                    fi
                    body="$body,\"type\":\"$tt\"}"
                    curl_admin_api "$tok" "${totp:-}" -sL --max-time 10 "${api}/api/targets/$tid" -X DELETE \
                    2>/dev/null
                    if [[ -n "$totp" ]]; then
                        local result=$(curl_admin_api "$tok" "${totp:-}" -sL --max-time 10 "${api}/api/targets" -X POST \
                    -H "Content-Type: application/json" \
                             -d "$body" 2>/dev/null)
                    else
                        local result=$(curl_admin_api "$tok" "${totp:-}" -sL --max-time 10 "${api}/api/targets" -X POST \
                    -H "Content-Type: application/json" \
                            -d "$body" 2>/dev/null)
                    fi
                    echo "$result" | grep -q '"ok": true' && ok "已迁移至 $nid" || err "失败"
                else
                    local body="{\"name\":\"$name\",\"group_name\":\"$group\""
                    if [[ "$tt" == "http" ]]; then
                        IFS= read -rp "  URL [${turls[$idx]}]: " ur </dev/tty; [[ -n "$ur" ]] && body="$body,\"url\":\"$ur\""
                    else
                        read -rp "  主机 [${thosts[$idx]}]: " ho </dev/tty; [[ -n "$ho" ]] && body="$body,\"target_host\":\"$ho\""
                        read -rp "  端口 [${tports[$idx]}]: " po </dev/tty; [[ -n "$po" ]] && body="$body,\"target_port\":$po"
                    fi
                    body="$body}"
                    if [[ -n "$totp" ]]; then
                        local result=$(curl_admin_api "$tok" "${totp:-}" -sL --max-time 10 "${api}/api/targets/$tid" -X PATCH \
                    -H "Content-Type: application/json" \
                             -d "$body" 2>/dev/null)
                    else
                        local result=$(curl_admin_api "$tok" "${totp:-}" -sL --max-time 10 "${api}/api/targets/$tid" -X PATCH \
                    -H "Content-Type: application/json" \
                            -d "$body" 2>/dev/null)
                    fi
                    echo "$result" | grep -q '"ok": true' && ok "已更新" || err "失败"
                fi
                ;;
            d|D)
                read -rp "  删除编号: " num </dev/tty
                [[ "$num" =~ ^[0-9]+$ && "$num" -ge 1 && "$num" -le $tc ]] || { warn "无效"; continue; }
                local idx=$((num - 1))
                local result=$(curl_admin_api "$tok" "${totp:-}" -sL --max-time 10 "${api}/api/targets/${tids[$idx]}" -X DELETE \
                    2>/dev/null)
                echo "$result" | grep -q '"ok": true' && ok "已删除 ${tids[$idx]}" || err "失败"
                ;;
            t|T)
                read -rp "  切换编号: " num </dev/tty
                [[ "$num" =~ ^[0-9]+$ && "$num" -ge 1 && "$num" -le $tc ]] || { warn "无效"; continue; }
                local idx=$((num - 1)); local nv=1
                [[ "${tenabled[$idx]}" == "1" ]] && nv=0
                local result=$(curl_admin_api "$tok" "${totp:-}" -sL --max-time 10 "${api}/api/targets/${tids[$idx]}" -X PATCH \
                    -H "Content-Type: application/json" \
                    -d "{\"enabled\":$nv}" 2>/dev/null)
                echo "$result" | grep -q '"ok": true' && ok "已切换 ${tids[$idx]}" || err "失败"
                ;;
            *) warn "无效选择" ;;
        esac
    done
}

do_admin_pings() {
    local api="$1" tok="$2" totp="$3"
    while true; do
        local list_json
        if [[ -n "$totp" ]]; then
            list_json=$(curl_admin_api "$tok" "${totp:-}" -sL --max-time 10 "${api}/api/ping-targets" \
                    -H "Accept: application/json" \
                    2>/dev/null) || true
        else
            list_json=$(curl_admin_api "$tok" "${totp:-}" -sL --max-time 10 "${api}/api/ping-targets" \
                    -H "Accept: application/json" 2>/dev/null) || true
        fi
        local ol=$(echo "$list_json" | tr -d '\r\n\t ')
        local pr="${ol//'{"id"'/${NL}{\"id\"}}"
        local pc=0
        declare -a pids=() pnames=() ptgts=() penabled=()
        echo -e "\n${BOLD}Ping 目标${NC}\n"
        printf "  %-4s %-24s %-32s %s\n" "#" "ID" "目标" "状态"
        printf "  %-4s %-24s %-32s %s\n" "---" "------------------------" "--------------------------------" "------"
        while IFS= read -r obj; do
            [[ -z "$obj" ]] && continue
            echo "$obj" | grep -q '^{"id"' || continue
            local pid=$(echo "$obj" | grep -o '"id":"[^"]*"' | head -1 | sed 's/"id":"//;s/"//') || true
            local pn=$(echo "$obj" | grep -o '"name":"[^"]*"' | head -1 | sed 's/"name":"//;s/"//') || true
            local pt=$(echo "$obj" | grep -o '"target":"[^"]*"' | head -1 | sed 's/"target":"//;s/"//') || true
            local pe=$(echo "$obj" | grep -o '"enabled":[0-9]*' | head -1 | sed 's/"enabled"://') || true
            [[ -z "$pid" ]] && continue
            pc=$((pc + 1))
            pids+=("$pid"); pnames+=("$pn"); ptgts+=("$pt"); penabled+=("$pe")
            printf "  ${CYAN}%-4s${NC} %-24s %-32s %s\n" "${pc})" "$pid" "$pt" "$([[ "$pe" == "1" ]] && echo -e "${GREEN}启用${NC}" || echo -e "${RED}禁用${NC}")"
        done <<< "$pr"
        echo
        echo -e "  ${BOLD}a${NC}) 新增   ${BOLD}d${NC}) 删除   ${BOLD}t${NC}) 切换   ${BOLD}q${NC}) 返回"
        echo
        read -rp "  选择: " sel </dev/tty
        case "${sel:-q}" in
            q|Q) break ;;
            a)
                read -rp "  ID: " nid </dev/tty
                IFS= read -rp "  名称: " nname </dev/tty
                IFS= read -rp "  目标 (主机:端口): " ntarget </dev/tty
                [[ -z "$nname" || -z "$ntarget" ]] && { warn "名称和目标不能为空"; continue; }
                local result=$(curl_admin_api "$tok" "${totp:-}" -sL --max-time 10 "${api}/api/ping-targets" -X POST \
                    -H "Content-Type: application/json" \
                    -d "{\"id\":\"${nid:-$nname}\",\"name\":\"$nname\",\"target\":\"$ntarget\"}" 2>/dev/null)
                echo "$result" | grep -q '"ok": true' && ok "添加成功" || err "失败"
                ;;
            d)
                read -rp "  删除编号: " num </dev/tty
                [[ "$num" =~ ^[0-9]+$ && "$num" -ge 1 && "$num" -le $pc ]] || { warn "无效"; continue; }
                local idx=$((num - 1))
                local result=$(curl_admin_api "$tok" "${totp:-}" -sL --max-time 10 "${api}/api/ping-targets/${pids[$idx]}" -X DELETE \
                    2>/dev/null)
                echo "$result" | grep -q '"ok": true' && ok "已删除 ${pids[$idx]}" || err "失败"
                ;;
            t)
                read -rp "  切换编号: " num </dev/tty
                [[ "$num" =~ ^[0-9]+$ && "$num" -ge 1 && "$num" -le $pc ]] || { warn "无效"; continue; }
                local idx=$((num - 1)); local nv=1
                [[ "${penabled[$idx]}" == "1" ]] && nv=0
                local result=$(curl_admin_api "$tok" "${totp:-}" -sL --max-time 10 "${api}/api/ping-targets/${pids[$idx]}" -X PATCH \
                    -H "Content-Type: application/json" \
                    -d "{\"enabled\":$nv}" 2>/dev/null)
                echo "$result" | grep -q '"ok": true' && ok "已切换 ${pids[$idx]}" || err "失败"
                ;;
            *) warn "无效选择" ;;
        esac
    done
}

do_totp_setup() {
    read_env
    local api="${NSTATUS_API_BASE:-}"
    local username="admin" password="" session=""
    read -rp "  管理员账号 [admin]: " username </dev/tty
    username="${username:-admin}"
    read -rsp "  管理员密码: " password </dev/tty
    echo
    [[ -z "$password" ]] && { err "密码不能为空"; return 1; }
    session=$(admin_login "$api" "$username" "$password" "") || return 1
    password=""

    local result=$(curl_admin_api "$session" "" -sS --max-time 10 "${api}/api/totp/setup" \
        -X POST 2>&1) || true

    if ! echo "$result" | grep -q '"ok": true'; then
        err "设置失败: $result"
        return 1
    fi

    local secret=$(echo "$result" | grep -o '"secret":"[^"]*"' | head -1 | sed 's/"secret":"//;s/"//')
    local uri=$(echo "$result" | grep -o '"uri":"[^"]*"' | head -1 | sed 's/"uri":"//;s/"//')

    echo -e "\n${BOLD}扫描二维码或手动输入密钥:${NC}\n"

    if command -v qrencode &>/dev/null; then
        echo "$uri" | qrencode -t UTF8 -m 1 -s 2
    fi

    echo
    printf "  ${BOLD}密钥:${NC}  ${CYAN}%s${NC}\n" "$secret"
    echo "  账号: 聶.NET:admin"
    echo "  位数: 6"
    echo
    read -rp "  输入当前验证码确认: " code </dev/tty
    [[ -z "$code" ]] && { err "验证码不能为空"; return 1; }

    local verify=$(curl_admin_api "$session" "" -sS --max-time 10 "${api}/api/totp/verify" \
        -X POST  \
        -H "Content-Type: application/json" \
        -d "{\"code\":\"$code\"}" 2>&1) || true

    if echo "$verify" | grep -q '"ok": true'; then
        ok "TOTP 已启用。以后 cftz admin 需要输入验证码。"
    else
        err "验证失败，请重新运行 cftz totp-setup。"
    fi
}

case "${1:-}" in
    install)   do_install ;;
    uninstall) do_uninstall ;;
    update)    do_update "${2:-}" ;;
    log)       do_log "${2:-30}" ;;
    set)       do_set ;;
    status)    do_status ;;
    admin)     do_admin ;;
    totp-setup) do_totp_setup ;;
    *)
        echo -e "${BOLD}cftz${NC} - 聶.NET VPS Agent 管理工具"
        echo
        echo "  cftz install    安装 Agent"
        echo "  cftz uninstall  完全移除 Agent"
        echo "  cftz update     更新到最新版本"
        echo "  cftz log [N]    查看最近 N 行日志 (默认30)"
        echo "  cftz set        配置 API / Token / 目标 / Ping"
        echo "  cftz admin      管理探针目标 (增/删/改/切换)"
        echo "  cftz status     查看服务状态"
        echo
        ;;
esac
